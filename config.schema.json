{
  "pluginAlias": "CubyHelios",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "# Cuby Helios\nConsulta el nivel de gas de tu Cuby Helios y lo muestra en HomeKit. El plugin genera y renueva el JWT automáticamente.",
  "footerDisplay": "La alerta indica gas bajo, no una fuga real. Se activa una vez por ciclo y se reinicia ante una subida de 10 puntos confirmada en dos lecturas. Las notificaciones dependen de los ajustes de la app Casa.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Nombre",
        "type": "string",
        "default": "Cuby Helios"
      },
      "email": {
        "title": "Correo de Cuby",
        "type": "string",
        "format": "email"
      },
      "password": {
        "title": "Contraseña de Cuby",
        "type": "string",
        "x-schema-form": {
          "type": "password"
        }
      },
      "deviceID": {
        "title": "Cuby Device ID",
        "type": "string",
        "minLength": 12,
        "maxLength": 12,
        "pattern": "^[A-Za-z0-9]{12}$"
      },
      "pollingInterval": {
        "title": "Intervalo de actualización (segundos)",
        "type": "integer",
        "minimum": 60,
        "maximum": 3600,
        "default": 300
      },
      "tokenExpiration": {
        "title": "Duración solicitada del JWT (segundos)",
        "type": "integer",
        "minimum": 300,
        "maximum": 2592000,
        "default": 3600
      },
      "lowGasThreshold": {
        "title": "Umbral de gas bajo (%)",
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "default": 20,
        "multipleOf": 1
      },
      "displayMode": {
        "title": "Mostrar nivel como",
        "type": "string",
        "enum": [
          "humidity",
          "battery"
        ],
        "default": "humidity",
        "description": "humidity: humedad; battery: batería."
      },
      "enableLowGasAlert": {
        "title": "Activar alerta de gas bajo",
        "type": "boolean",
        "default": false
      }
    },
    "required": [
      "name",
      "email",
      "password",
      "deviceID"
    ]
  }
}
